# FocusFlow local development

# Web UI (Vite)
WEB_HOST=127.0.0.1
WEB_PORT=5173
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_ANKI_CONNECT_URL=http://127.0.0.1:8765

# Go API
API_HOST=127.0.0.1
API_PORT=8080
APP_ORIGIN=http://127.0.0.1:5173
APP_ENV=development
SESSION_TTL_HOURS=720
STATIC_DIR=

# PostgreSQL
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=focusflow
POSTGRES_USER=focusflow
POSTGRES_PASSWORD=focusflow
DATABASE_URL=postgres://focusflow:focusflow@127.0.0.1:5432/focusflow?sslmode=disable

# Web Push (optional in local development)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
